[opticalflow]

##### Main / 基本设置

# GPU device selection: e.g. "0,1,3"; use "cpu" for CPU mode; "mps" for Apple Silicon (M1/M2)

# GPU设备选择：如"0,1,3"；CPU模式用"cpu"；Apple芯片用"mps"

gpu = mps

# Input image color space: image(rgb), in_rec709(sRGB), or ACESCG

# 输入图像颜色空间：image(rgb)、in_rec709(sRGB) 或 ACESCG

color_space = image

# Frame step for motion vectors (MV): 1 means mv0/mv1; 1,2,3 means mv0~mv6

# 运动矢量帧间隔：1表示mv0/mv1；1,2,3表示mv0~mv6

frame_step = 1

# Merge mv0 and mv1 into MM9 format

# 是否合并mv0和mv1为MM9格式

MM9_format = 0

##### Algorithms / 算法设置

# Available optical flow methods: farneback, deepflow, simpleflow, stdf, pcaflow, rlof

# 可选光流算法：farneback, deepflow, simpleflow, stdf, pcaflow, rlof

# mm uses: kousei-<version>-<id>, mma uses: mma-<version>-<id>

# mm模型格式：kousei-版本号-序列号；mma模型：mma-版本号-序列号

# Example: kousei-v1-230908280

# 示例：kousei-v1-230908280

# Model source:

# 1) Auto download via mmalgo

# 2) Manual download from server (/dept/TCShared/qhong/mm_checkpoints)

# 模型来源：

# 1）通过mmalgo自动获取

# 2）云端下载后放入 mm/checkpoints（需手动创建）

